{
  "name": "my-qwik-empty-starter",
  "description": "Blank project with routing included",
  "engines": {
    "node": "^18.17.0 || ^20.3.0 || >=21.0.0"
  },
  "engines-annotation": "Mostly required by sharp which needs a Node-API v9 compatible runtime",
  "private": true,
  "trustedDependencies": [
    "sharp"
  ],
  "trustedDependencies-annotation": "Needed for bun to allow running install scripts",
  "type": "module",
  "scripts": {
    "build": "qwik build",
    "build.client": "vite build",
    "build.preview": "vite build --ssr src/entry.preview.tsx",
    "build.types": "tsc --incremental --noEmit",
    "deploy": "echo 'Run \"npm run qwik add\" to install a server adapter'",
    "dev": "vite --mode ssr",
    "dev.debug": "node --inspect-brk ./node_modules/vite/bin/vite.js --mode ssr --force",
    "fmt": "prettier --write .",
    "fmt.check": "prettier --check .",
    "lint": "eslint \"src/**/*.ts*\"",
    "preview": "qwik build preview && vite preview --open",
    "start": "vite --open --mode ssr",
    "test.unit": "vitest components",
    "test.unit.ui": "vitest --ui components",
    "qwik": "qwik",
    "cert": "rmdir /s /q cert && mkdir cert && mkcert -key-file cert/key.pem -cert-file cert/cert.pem 192.168.118.6"
  },
  "devDependencies": {
    "@builder.io/partytown": "^0.10.3",
    "@builder.io/qwik": "^1.12.1",
    "@builder.io/qwik-city": "^1.12.1",
    "@types/eslint": "9.6.1",
    "@types/node": "22.12.0",
    "@typescript-eslint/eslint-plugin": "8.26.1",
    "@typescript-eslint/parser": "8.26.1",
    "@vitest/ui": "^3.0.8",
    "autoprefixer": "^10.4.21",
    "eslint": "9.22.0",
    "eslint-plugin-qwik": "^1.12.1",
    "monaco-editor": "^0.52.2",
    "postcss-preset-env": "^10.1.5",
    "prettier": "3.4.2",
    "prettier-plugin-tailwindcss": "^0.6.11",
    "typescript": "5.7.3",
    "undici": "^7.4.0",
    "vite": "6.2.1",
    "vite-tsconfig-paths": "^5.1.4",
    "vitest": "^3.0.8"
  },
  "dependencies": {
    "@builder.io/dev-tools": "^1.6.6",
    "@emotion/react": "^11.14.0",
    "@emotion/styled": "^11.14.0",
    "@monaco-editor/loader": "^1.5.0",
    "@monaco-editor/react": "^4.7.0",
    "@mui/material": "^6.4.7",
    "@tailwindcss/postcss": "^4.0.12",
    "@tailwindcss/vite": "^4.0.12",
    "@vitejs/plugin-basic-ssl": "^2.0.0",
    "glob": "^11.0.1",
    "i": "^0.3.7",
    "lib0": "^0.2.99",
    "lru-cache": "^11.0.2",
    "npm": "^11.2.0",
    "postcss": "^8.5.3",
    "rimraf": "^6.0.1",
    "socket.io-client": "^4.8.1",
    "tailwindcss": "^4.0.12",
    "uuid": "^11.1.0",
    "vite-plugin-mkcert": "^1.17.7",
    "vite-plugin-monaco-editor": "^1.1.0",
    "y-monaco": "^0.1.6",
    "y-protocols": "^1.0.6",
    "yjs": "^13.6.24"
  }
}
